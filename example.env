# Example environment variables - DO NOT STORE SECRETS HERE
# Copy this to `.env` and fill with real values for local development.

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/yourdb

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT
JWT_SECRET_KEY=change-this-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# SMTP (for Email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-app-password
